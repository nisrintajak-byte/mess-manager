{
  "expo": {
    "name": "Mess Manager",
    "slug": "mess-manager",
    "scheme": "messmanager",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.uyoontech.messmanager",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.uyoontech.messmanager",
      "supportsTablet": true,
      "infoPlist": {}
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-localization",
      "expo-secure-store",
      "expo-local-authentication",
      "expo-font",
      "expo-web-browser",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ]
    ],
    "experiments": {
      "baseUrl": "/mess-manager"
    },
    "extra": {
      "eas": {
        "projectId": "e7c9027c-9e45-44e9-9c5f-fdb8e4122dc5"
      }
    },
    "owner": "nisrintajak"
  }
}
