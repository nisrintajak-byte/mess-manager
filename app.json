{
  "expo": {
    "name": "Mess Manager",
    "slug": "mess-manager",
    "scheme": "messmanager",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.uyoontech.messmanager",
      "predictiveBackGestureEnabled": false
    },
    "ios": {
      "bundleIdentifier": "com.uyoontech.messmanager",
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-localization",
      "expo-secure-store",
      "expo-local-authentication",
      "expo-font",
      "expo-web-browser",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      "react-native-iap"
    ],
    "experiments": {
      "baseUrl": "/mess-manager"
    }
  }
}
